# Django Settings
SECRET_KEY=your-secret-key-here-generate-new-one
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_VITE_DEV=False

# Database
DB_NAME=interview_management
DB_USER=postgres
DB_PASSWORD=your-password-here
DB_HOST=db
DB_PORT=5432

# Redis & Celery
# Задайте REDIS_PASSWORD и тот же пароль в URL
REDIS_PASSWORD=password
REDIS_URL=redis://password@redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# true — не подключать vector_search, пока нет ключа OpenAI
DISABLE_VECTOR=true

# Vector Search — OpenAI-совместимый API
OPENAI_API_KEY=your-llm-api-service-token-here
OPENAI_BASE_URL=https://api.openai.com/v1
EMBEDDING_MODEL_NAME=text-embedding-3-small
EMBEDDING_DIMENSION=1536
EMBEDDING_BATCH_SIZE=100
SEMANTIC_SEARCH_TOP_K=10
SEMANTIC_SEARCH_MIN_SCORE=0.3

# Яндекс Диск — legacy: транскрипция старых video_link, не новые загрузки портала
YA_TOKEN=your-yandex-disk-token-here
YA_UPLOAD_DIR=your-upload-directory-here

# S3 — загрузка видео со студенческого портала
S3_ENDPOINT_URL=https://s3.example.com
S3_REGION=default
S3_ACCESS_KEY_ID=your-s3-access-key-id
S3_SECRET_ACCESS_KEY=your-s3-secret-access-key
S3_VIDEO_BUCKET=interview-videos
S3_VIDEO_PREFIX=
# TTL presigned URL при отдаче API (секунды); в БД хранится стабильный URL, подпись обновляется при каждом запросе
S3_PRESIGNED_EXPIRES=86400

DEEPGRAM_API_KEY=your-deepgram-api-key-here
DEEPGRAM_PROJECT_ID=your-deepgram-project-id-here

# Вход локальный. Демо-учётки: admin/demo-admin, manager/demo-manager, student/demo-student.
